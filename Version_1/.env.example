# Configuración de la API Biblioteca UCaldas - Versión 1

# Host y puerto del servidor
HOST=0.0.0.0
PORT=8000

# Ambiente
ENVIRONMENT=development

# Base de datos (en versión 1 se usa memoria, en versión 2 se usará SQL)
DATABASE_TYPE=memory

# Configuración de logs
LOG_LEVEL=INFO

# Configuración de CORS (para versión futura)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
